# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend ───────────────────────────────────────────────────
APP_VERSION=1.1.0

# ── SEO (сборка) ─────────────────────────────────────────────────
# Публичный адрес приложения с префиксом, напр. https://example.com/whisper/
# Включает canonical, hreflang, sitemap.xml и JSON-LD. Без него генерируется только robots.txt.
SITE_URL=

# ── Облачный экспорт проектов (браузерный OAuth, необязательно) ──
# Можно не задавать: ключ вводится в окне экспорта и хранится в браузере.
# Redirect URI во всех консолях: публичный адрес приложения с префиксом (напр. https://example.com/whisper/)
VITE_GDRIVE_CLIENT_ID=    # Google Cloud: OAuth client (Web), scope drive.file; JS origin = адрес сайта
VITE_YANDEX_CLIENT_ID=    # oauth.yandex.ru: доступ cloud_api:disk.app_folder или disk.write/read
VITE_DROPBOX_APP_KEY=     # dropbox.com/developers: scopes files.content.write/read

# ── Google Диск через серверные креды (необязательно) ────────────
# Если заданы оба, в окне экспорта Client ID вводить не нужно: вход выполняет сервер,
# секрет в браузер не попадает. Google Cloud → OAuth client (Web), scope drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI (добавить в Authorized redirect URIs), напр. https://example.com/whisper/api/google/callback
# Если не задан — собирается из заголовков прокси и префикса приложения.
GOOGLE_REDIRECT_URI=
